<extension type="package" method="upgrade">
    <name>pkg_ars</name>
    <author>Nicholas K. Dionysopoulos</author>
    <creationDate>##DATE##</creationDate>
    <packagename>ars</packagename>
    <version>##VERSION##</version>
    <url>https://www.akeeba.com</url>
    <packager>Akeeba Ltd</packager>
    <packagerurl>https://www.akeeba.com</packagerurl>
    <copyright>Copyright (c)2010-2024 Nicholas K. Dionysopoulos / Akeeba Ltd</copyright>
    <license>GNU GPL v3 or later</license>
    <description>PKG_ARS_XML_DESCRIPTION</description>
    <blockChildUninstall>true</blockChildUninstall>

    <files>
        <file type="component" id="com_ars">com_ars.zip</file>

        <file type="module" client="site" id="mod_arsdownloads">mod_arsdownloads.zip</file>
        <file type="module" client="administrator" id="mod_arsgraph">mod_arsgraph.zip</file>

        <file type="plugin" group="content" id="arsdlid">plg_content_arsdlid.zip</file>
        <file type="plugin" group="content" id="arslatest">plg_content_arslatest.zip</file>

        <file type="plugin" group="editors-xtd" id="arslink">plg_editors-xtd_arslink.zip</file>

        <file type="plugin" group="webservices" id="ars">plg_webservices_ars.zip</file>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/pkg_ars.sys.ini</language>
        <language tag="de-DE">de-DE/pkg_ars.sys.ini</language>
        <language tag="el-GR">el-GR/pkg_ars.sys.ini</language>
        <language tag="es-ES">es-ES/pkg_ars.sys.ini</language>
        <language tag="fr-FR">fr-FR/pkg_ars.sys.ini</language>
        <language tag="it-IT">it-IT/pkg_ars.sys.ini</language>
        <language tag="pt-PT">pt-PT/pkg_ars.sys.ini</language>
    </languages>

    <scriptfile>script.ars.php</scriptfile>

    <!--
        CWM: the upstream <updateservers> block pointing at http://cdn.akeeba.com/updates/ars.xml
        is deliberately removed.

        We build and install ARS ourselves from Joomla-Bible-Study/release-system, carrying local
        commits on top of upstream. Leaving the update site registered means Joomla offers Akeeba's
        official releases in the Extensions updater, and accepting one silently overwrites our
        build. Upstream also documents ARS as an internal project with no support, no semver, and
        no guarantee a feature survives the next minor release, so we pin instead of tracking.

        Update ARS by installing our own package. Do not restore this block without also deciding
        how the pinned build is protected.

        Note: removing this from the manifest stops NEW installs registering the update site; it
        does not necessarily delete an already-registered row from #__update_sites. Check
        System -> Update Sites on each site and disable "Akeeba Release System Updates" there too.
    -->
</extension>